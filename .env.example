# Copy to .env for local API development. This replica set is local and unauthenticated.
DATABASE_URL=mongodb://127.0.0.1:27017/chatapp_dev?replicaSet=chatapp-rs&directConnection=true
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
CORS_ORIGINS=

# Generate a unique key with openssl rand -hex 32. This is server-only.
AUTH_SIGNING_KEY=
AUTH_ISSUER=chatapp-api

# Optional attachment storage. Generate local keys and use a private bucket.
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_MAX_UPLOAD_BYTES=10485760
