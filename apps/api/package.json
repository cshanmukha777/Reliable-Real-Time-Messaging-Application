{
  "name": "@chatapp/api",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build && node --env-file-if-exists=../../.env --watch dist/main.js",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "prisma:generate": "prisma generate",
    "db:push": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js db push"
  },
  "dependencies": {
    "@chatapp/contracts": "0.2.0",
    "@nestjs/common": "11.2.12",
    "@nestjs/core": "11.2.12",
    "@nestjs/platform-express": "11.2.12",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "jsonwebtoken": "9.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "prisma": "6.19.3"
  }
}
