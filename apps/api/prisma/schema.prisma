generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model FoundationProbe {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String
  createdAt DateTime @default(now())

  @@map("foundation_probes")
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

model User {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  email        String        @unique
  passwordHash String
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lastLoginAt  DateTime?
  profile      Profile?
  sessions     Session[]
}

model Profile {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @unique @db.ObjectId
  user         User     @relation(fields: [userId], references: [id])
  displayName  String
  avatarUrl    String?
  discoveryKey String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([discoveryKey, userId])
}

model Session {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  userId       String         @db.ObjectId
  user         User           @relation(fields: [userId], references: [id])
  refreshHash  String         @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime       @default(now())
  lastActiveAt DateTime       @default(now())
  usedTokens   SpentRefresh[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model SpentRefresh {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  hash          String   @unique
  sessionId     String   @db.ObjectId
  session       Session  @relation(fields: [sessionId], references: [id])
  operationHash String
  rotatedAt     DateTime @default(now())

  @@index([sessionId])
}

enum ConversationKind {
  DIRECT
  GROUP
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

model Conversation {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  identityKey String           @unique
  fingerprint String
  kind        ConversationKind
  title       String?
  directUsers String[]         @db.ObjectId
  sequence    Int              @default(0)
  revision    Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now())

  @@map("conversations")
}

model Membership {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String     @db.ObjectId
  userId         String     @db.ObjectId
  role           MemberRole
  active         Boolean
  visibleFrom    Int

  @@unique([conversationId, userId])
  @@index([userId, active, conversationId])
  @@index([conversationId, active, userId])
  @@map("memberships")
}

model Message {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  conversationId  String    @db.ObjectId
  senderId        String    @db.ObjectId
  clientMessageId String
  fingerprint     String
  sequence        Int
  body            String?
  attachmentIds   String[]  @db.ObjectId
  createdAt       DateTime
  deletedAt       DateTime?

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("messages")
}

enum AttachmentState {
  PENDING
  VERIFIED
  ATTACHED
}

model Attachment {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String          @db.ObjectId
  ownerId        String          @db.ObjectId
  state          AttachmentState
  fileName       String
  mimeType       String
  size           Int
  stagingKey     String
  verifiedKey    String?
  messageId      String?         @db.ObjectId
  expiresAt      DateTime

  @@index([ownerId, state, expiresAt])
  @@map("attachments")
}
